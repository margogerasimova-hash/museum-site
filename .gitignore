# Файли, які не мають потрапити на GitHub.
# Увага: .gitignore діє лише на файли, які ще не додані в git.
# Уже закомічені файли треба окремо прибрати з репозиторію (git rm --cached).

# --- Локальні налаштування Claude Code ---
# Дозволи для Claude на цьому комп'ютері: шляхи з іменем користувача, тимчасові папки.
.claude/settings.local.json

# --- Внутрішні робочі документи ---
# ТЗ і звіт для розробки: внутрішні документи музею, не частина сайту.
*.docx
# Тимчасові файли, які Word створює, поки документ відкритий.
~$*
# Робочі нотатки про хід розробки, відкриті питання й інциденти безпеки.
handoff.md
# Сирі відгуки відвідувачів: на сайт уже перенесено відредаговану версію.
vidguky.txt

# --- Паролі, ключі й особисті нотатки (на майбутнє) ---
# Файл нотаток із паролем уже прибрано; рядок не дасть додати його знову.
notatky.txt
# Файли змінних середовища: у них зазвичай зберігають ключі й паролі.
.env
.env.*
# Файли приватних ключів і сертифікатів.
*.key
*.pem

# --- Службові файли Windows і macOS ---
# Ескізи зображень у папках Windows.
Thumbs.db
# Налаштування вигляду папки у Windows.
desktop.ini
# Службовий файл Finder на Mac.
.DS_Store
